# Shared PSK for all testbed config variants -- lab-only, never reuse in production.
172.20.0.10 172.20.0.20 : PSK "testbed-preshared-key-change-me"

# IPv6 variants (see the ipv6 .conf files' header comments -- these need an
# IPv6-enabled network added to docker-compose.yml before they'll actually run).
fd00:172:20::10 fd00:172:20::20 : PSK "testbed-preshared-key-change-me"
